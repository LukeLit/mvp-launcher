# Required environment variables for MVP Launcher

# Vercel Gateway API key for AI analysis (Haiku model)
API_GATEWAY=your_vercel_gateway_api_key_here

# Optional: Vercel Gateway API URL (defaults to https://api.vercel.com/v1/ai)
# API_GATEWAY_URL=https://api.vercel.com/v1/ai

# Slack webhook URL for notifications
SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Optional: Reddit API credentials (not required for JSON API, but recommended for higher rate limits)
# REDDIT_CLIENT_ID=your_reddit_client_id
# REDDIT_CLIENT_SECRET=your_reddit_client_secret
# REDDIT_USER_AGENT=MVP-Launcher-Bot/1.0

# IMPORTANT: Cron secret for securing the /api/scan endpoint
# Required for production to prevent unauthorized access
CRON_SECRET=your_random_secret_here
